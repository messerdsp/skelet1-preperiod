+fn item_plain(i: &Item) -> String {
+    match *i {
+        Item::D => "D".into(), Item::P => "P".into(), Item::C(c) => format!("{c}"), Item::X(n) => format!("x^{n}"),
+        Item::L(r) => format!("L({r})"), Item::E { block, exp } => format!("{}^{exp}", (block + b'a') as char),
+        Item::Unreachable => "!".into(),
+    }
+}
+
+// R+L sweep cost of one item (right sweep + left sweep).
+fn rl_cost(item: &Item) -> BigUint {
+    match *item {
+        Item::X(n) => BigUint::from(n) * 16u32,
+        Item::D => BigUint::from(16u32),
+        Item::E { block: 1, exp } => BigUint::from(exp) * 1_726_192u32,
+        _ => panic!("rl_cost: unexpected item {item:?}"),
+    }
+}
+
+/// Exact TM steps of `n` level-1 counter strides from `> rtape` to `< rtape'`.
+fn counter_cost(rtape: &[Item], n: Exp) -> BigUint {
+    assert_eq!(rtape.first(), Some(&Item::P));
+    let mut segs: Vec<BigUint> = vec![BigUint::default()];
+    for item in rtape[1..].iter().rev() {
+        match item {
+            Item::C(3) => segs.push(BigUint::default()),
+            Item::C(_) => panic!("counter_cost: non-3 digit"),
+            _ => { let c = rl_cost(item); *segs.last_mut().unwrap() += c; }
+        }
+    }
+    let k = segs.len() - 1;
+    let mut st = segs[k].clone() + 9u32;
+    let mut d = BigUint::default();
+    for j in (1..=k).rev() {
+        st = segs[j - 1].clone() + 99u32 + st * 4u32 + d.clone() * 6u32;
+        d = d * 16u32 + 112u32;
+    }
+    let n = BigUint::from(n);
+    let tri = if n > BigUint::default() { n.clone() * (n.clone() - 1u32) / 2u32 } else { BigUint::default() };
+    n * st + d * tri
+}
